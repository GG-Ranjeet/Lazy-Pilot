{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
  "core:default",
  "shell:allow-spawn",
  {
    "identifier": "shell:allow-sidecar",
    "allow": [
      {
        "name": "scrcpy",
        "args": [
          "-s",
          { "validator": ".*" }, 
          "--always-on-top"
        ]
      }
    ]
  }
]
}
