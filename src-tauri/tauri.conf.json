{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lazy Pilot",
  "version": "0.1.0",
  "identifier": "com.ranjeet.lazypilot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mytauriapp",
        "width": 1120,
        "minWidth": 800,
        "maxWidth": 1120,
        "height": 780,
        "minHeight": 500,
        "maxHeight": 780,
        "center": false,
        "x": 0,
        "y": 0,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
